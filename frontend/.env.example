# RoofToGrid web app — copy to .env.local for development.

# Base URL of the API, including the version prefix.
# Local:      http://localhost:4000/api/v1
# Production: https://api.rooftogrid.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Site URL for canonical and Open Graph metadata
NEXT_PUBLIC_SITE_URL=https://rooftogrid.in

# RoofToGrid UPI VPA for direct Pro subscription payments
NEXT_PUBLIC_UPI_ID=rooftogrid@okaxis
