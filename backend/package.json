{
  "name": "rooftogrid-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RoofToGrid API — rooftop solar planning, quote comparison, and project tracking",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@supabase/supabase-js": "2.111.0",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.7",
    "@types/multer": "1.4.12",
    "@types/node": "22.13.1",
    "@types/supertest": "6.0.2",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
