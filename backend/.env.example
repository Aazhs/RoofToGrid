# RoofToGrid API — copy to .env and fill in. Never commit .env (NFR-S7).

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---------------------------------------------------------------- database
# Supabase: pooled connection (pgbouncer, port 6543) for the app.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (port 5432) used only by prisma migrate.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Local Postgres alternative:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rooftogrid?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rooftogrid?schema=public"

# ---------------------------------------------------------------- auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------- http
# Comma-separated allowlist. Add your Vercel preview and production domains in production.
CORS_ORIGINS=http://localhost:3000
# Set only when the API and app share a registrable domain, e.g. .rooftogrid.com
# COOKIE_DOMAIN=.rooftogrid.com
TRUST_PROXY=true

# ---------------------------------------------------------------- storage
# local  -> files written to UPLOAD_DIR (development)
# supabase -> private Supabase Storage bucket (production)
STORAGE_DRIVER=local
UPLOAD_DIR=.uploads
MAX_UPLOAD_MB=10
SIGNED_URL_TTL_SECONDS=300

# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service-role-key-keep-secret
SUPABASE_STORAGE_BUCKET=rooftogrid-documents

# ---------------------------------------------------------------- domain providers
YIELD_ENGINE=rule-based
ASSUMPTION_SET_ID=IN_2026_07

# ---------------------------------------------------------------- seed
SEED_DEMO_EMAIL=demo@rooftogrid.com
SEED_DEMO_PASSWORD=DemoSolar#2026
